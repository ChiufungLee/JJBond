<!--components/summary-card/summary-card.wxml-->
<view class="summary-card" bindtap="onTap">
  <view class="card-header">
    <text class="card-title">今日收益</text>
  </view>

  <view class="card-body">
    <view class="revenue-main {{(summary.today_revenue || 0) >= 0 ? 'up' : 'down'}}">
      <text class="revenue-amount">
        {{(summary.today_revenue || 0) >= 0 ? '+' : ''}}{{summary.today_revenue_formatted || defaultSummary.today_revenue_formatted}}
      </text>
      <text class="revenue-percent">
        {{(summary.today_revenue || 0) >= 0 ? '+' : ''}}{{summary.today_revenue_percent || defaultSummary.today_revenue_percent}}%
      </text>
    </view>
  </view>

  <view class="card-footer">
    <view class="footer-item">
      <text class="footer-label">持有金额</text>
      <text class="footer-value">{{summary.today_holding_amount_formatted || '0.00'}}</text>
    </view>
    <view class="footer-item">
      <text class="footer-label">总成本</text>
      <text class="footer-value">{{summary.total_cost_formatted || '0.00'}}</text>
    </view>
    <view class="footer-item">
      <text class="footer-label">持有基金</text>
      <text class="footer-value">{{summary.fund_count || 0}}只</text>
    </view>
  </view>
</view>
