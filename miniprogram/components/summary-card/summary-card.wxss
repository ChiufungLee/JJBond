/* components/summary-card/summary-card.wxss */
.summary-card {
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.3);
}

.card-header {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  opacity: 0.9;
}

.card-body {
  margin-bottom: 28rpx;
}

.revenue-main {
  display: flex;
  align-items: baseline;
}

.revenue-amount {
  font-size: 64rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.revenue-percent {
  font-size: 32rpx;
  opacity: 0.9;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.footer-item {
  text-align: center;
  flex: 1;
}

.footer-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.footer-value {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}
