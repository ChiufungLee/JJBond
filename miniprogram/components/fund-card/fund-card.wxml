<!--components/fund-card/fund-card.wxml-->
<view class="fund-card" bindtap="onTap">
  <view class="fund-header">
    <view class="fund-info">
      <text class="fund-name">{{fund.fund_name || defaultFund.fund_name}}</text>
      <text class="fund-code">{{fund.fund_code || defaultFund.fund_code}}</text>
    </view>
    <view class="fund-rate {{fund.today_revenue >= 0 ? 'up' : 'down'}}">
      {{fund.change_rate || defaultFund.change_rate}}
    </view>
  </view>

  <view class="fund-body">
    <view class="fund-item">
      <text class="label">今日收益</text>
      <text class="value {{fund.today_revenue >= 0 ? 'up' : 'down'}}">
        {{fund.today_revenue >= 0 ? '+' : ''}}{{fund.today_revenue_formatted || '0.00'}}
      </text>
    </view>
    <view class="fund-item">
      <text class="label">持仓市值</text>
      <text class="value">{{fund.amount_formatted || '0.00'}}</text>
    </view>
    <view class="fund-item">
      <text class="label">收益率</text>
      <text class="value {{fund.profit_loss_ratio >= 0 ? 'up' : 'down'}}">
        {{fund.profit_loss_ratio_formatted || '0.00%'}}
      </text>
    </view>
  </view>
</view>
