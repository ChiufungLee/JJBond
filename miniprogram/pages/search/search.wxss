/* pages/search/search.wxss */
.search-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索框 */
.search-box {
  padding: 24rpx;
  background-color: #ffffff;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 搜索中状态 */
.searching-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空结果 */
.empty-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

/* 搜索结果 */
.search-results {
  padding: 24rpx;
}

.result-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.result-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.result-info {
  flex: 1;
  overflow: hidden;
}

.result-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-code {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.result-type {
  font-size: 24rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.result-action {
  padding: 0 24rpx 24rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-add {
  font-size: 26rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 搜索历史 */
.history-section {
  padding: 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.history-clear {
  font-size: 26rpx;
  color: #999;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
}

.history-item {
  background-color: #ffffff;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.empty-history {
  text-align: center;
  padding: 60rpx 0;
}

.empty-history .empty-text {
  color: #999;
  font-size: 28rpx;
}
