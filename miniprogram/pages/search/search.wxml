<!--pages/search/search.wxml-->
<view class="search-container">
  <!-- 搜索框 -->
  <view class="search-box">
    <input
      class="search-input"
      type="text"
      placeholder="输入基金代码或名称搜索"
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      focus="{{true}}"
    />
  </view>

  <!-- 搜索中状态 -->
  <view wx:if="{{searching}}" class="searching-state">
    <text>搜索中...</text>
  </view>

  <!-- 搜索结果 -->
  <view wx:elif="{{searched}}" class="search-results">
    <view wx:if="{{searchResults.length === 0}}" class="empty-result">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">未找到相关基金</text>
    </view>

    <view wx:else class="result-list">
      <view
        class="result-item"
        wx:for="{{searchResults}}"
        wx:key="fund_code"
      >
        <view class="result-main" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <view class="result-info">
            <text class="result-name">{{item.fund_name}}</text>
            <text class="result-code">{{item.fund_code}}</text>
          </view>
          <text class="result-type">{{item.fund_type || '其他'}}</text>
        </view>
        <view class="result-action">
          <button
            class="btn-add"
            catchtap="goToAddFund"
            data-code="{{item.fund_code}}"
            data-name="{{item.fund_name}}"
          >
            添加
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view wx:else class="history-section">
    <view class="history-header">
      <text class="history-title">搜索历史</text>
      <text class="history-clear" bindtap="clearHistory" wx:if="{{searchHistory.length > 0}}">清除</text>
    </view>

    <view wx:if="{{searchHistory.length > 0}}" class="history-list">
      <view
        class="history-item"
        wx:for="{{searchHistory}}"
        wx:key="*this"
        bindtap="onHistoryTap"
        data-keyword="{{item}}"
      >
        <text>{{item}}</text>
      </view>
    </view>

    <view wx:else class="empty-history">
      <text class="empty-text">暂无搜索历史</text>
    </view>
  </view>
</view>
