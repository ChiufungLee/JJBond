<view class="reward-container">
  <loading wx:if="{{loading}}" text="加载中..."></loading>

  <block wx:elif="{{announcements.length === 0}}">
    <view class="empty-tip">
      <text class="empty-text">暂无公告</text>
    </view>
  </block>

  <block wx:else>
    <view class="announcement-card" wx:for="{{announcements}}" wx:key="id">
      <text class="announcement-title">{{item.title}}</text>
      <text class="announcement-content">{{item.content}}</text>
    </view>
  </block>
</view>
