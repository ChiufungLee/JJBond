.reward-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.thank-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.thank-line {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  text-align: center;
}

.thank-title {
  font-size: 34rpx;
  font-weight: 600;
}

.thank-sub {
  color: #999;
  font-size: 26rpx;
}

.qrcode-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode {
  width: 360rpx;
}

.qrcode-hint {
  font-size: 30rpx;
  color: #333;
  margin-top: 24rpx;
}

.qrcode-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}