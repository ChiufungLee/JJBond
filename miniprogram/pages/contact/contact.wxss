/* pages/contact/contact.wxss */
.contact-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
}

.contact-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card-desc {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.contact-btn {
  background-color: #722ed1;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 80rpx;
  border-radius: 40rpx;
  border: none;
}

.contact-btn::after {
  border: none;
}

.contact-info {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.info-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-action {
  padding: 12rpx 24rpx;
  background-color: #f9f0ff;
  border-radius: 8rpx;
}

.info-action text {
  font-size: 24rpx;
  color: #722ed1;
}

.contact-tips {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.tips-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 2;
}
