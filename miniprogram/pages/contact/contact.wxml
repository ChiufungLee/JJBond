<!--pages/contact/contact.wxml-->
<view class="contact-container">
  <view class="contact-card">
    <text class="card-icon">📞</text>
    <text class="card-title">联系我们</text>
    <text class="card-desc">如有问题，欢迎通过以下方式联系我们</text>

    <!-- 使用微信官方客服按钮 -->
    <button class="contact-btn" open-type="contact">
      在线客服
    </button>
  </view>

  <view class="contact-info">
    <view class="info-title">其他联系方式</view>

    <view class="info-item">
      <view class="info-left">
        <text class="info-icon">📧</text>
        <view class="info-content">
          <text class="info-label">邮箱</text>
          <text class="info-value">{{contactInfo.email}}</text>
        </view>
      </view>
      <view class="info-action" bindtap="copyToClipboard" data-text="{{contactInfo.email}}">
        <text>复制</text>
      </view>
    </view>

    <view class="info-item">
      <view class="info-left">
        <text class="info-icon">💬</text>
        <view class="info-content">
          <text class="info-label">微信</text>
          <text class="info-value">{{contactInfo.wechat}}</text>
        </view>
      </view>
      <view class="info-action" bindtap="copyToClipboard" data-text="{{contactInfo.wechat}}">
        <text>复制</text>
      </view>
    </view>
  </view>

  <view class="contact-tips">
    <text class="tips-title">服务时间</text>
    <text class="tips-text">工作日 9:00 - 18:00</text>
    <text class="tips-text">我们会在1-2个工作日内回复</text>
  </view>
</view>
