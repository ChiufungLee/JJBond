<!--pages/market/market.wxml-->
<view class="market-container">
  <loading wx:if="{{loading}}" />

  <block wx:else>
    <!-- 指数分组 -->
    <view class="section" wx:for="{{groups}}" wx:key="name">
      <view class="section-title">{{item.name}}</view>
      <view class="card-wrap">
        <view class="card-row">
          <view
            wx:for="{{item.items}}"
            wx:for-item="idx"
            wx:key="code"
            class="index-card {{idx.isUp ? 'card-up' : 'card-down'}}"
          >
            <text class="idx-name">{{idx.name}}</text>
            <text class="idx-price {{idx.isUp ? 'up' : 'down'}}">{{idx.priceStr}}</text>
            <view class="idx-change-row">
              <text class="idx-change {{idx.isUp ? 'up' : 'down'}}">{{idx.changeStr}}</text>
              <text class="idx-pct {{idx.isUp ? 'up' : 'down'}}">{{idx.pctStr}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 指数加载失败空状态 -->
    <view class="section" wx:if="{{indicesError && groups.length === 0}}">
      <view class="section-title">股市指数</view>
      <view class="indices-empty">
        <text>暂无数据</text>
      </view>
    </view>

    <!-- 资金流入/流出榜 -->
    <view class="section" wx:if="{{loggedIn}}">
      <view class="flow-header">
        <view class="section-title">板块资金流向</view>
        <view class="flow-tabs">
          <view
            class="flow-tab {{activeFlowTab === 'inflow' ? 'flow-tab-active' : ''}}"
            data-tab="inflow"
            bindtap="onFlowTabChange"
          >资金流入</view>
          <view
            class="flow-tab {{activeFlowTab === 'outflow' ? 'flow-tab-active' : ''}}"
            data-tab="outflow"
            bindtap="onFlowTabChange"
          >资金流出</view>
        </view>
        <view class="rank-more" bindtap="goToSector">
          <text>更多</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>
      <text class="flow-time" wx:if="{{flowUpdateTime}}">更新于 {{flowUpdateTime}}</text>

      <view class="list-card">
        <view class="list-item" wx:for="{{flowList}}" wx:key="rank"
          bindtap="goToSectorDetail" data-code="{{item.code}}" data-name="{{item.name}}">
          <text class="item-rank">{{item.rank}}</text>
          <text class="item-name">{{item.name}}</text>
          <text class="item-value {{item.isUp ? 'up' : 'down'}}">{{item.valueStr}}</text>
        </view>
      </view>
    </view>

    <!-- 日涨幅排行榜 -->
    <view class="section" wx:if="{{loggedIn}}">
      <view class="rank-header">
        <view class="rank-title-row">
          <text class="section-title">日涨幅榜</text>
          <text class="rank-date" wx:if="{{rankingDate}}">{{rankingDate}}</text>
        </view>
        <view class="rank-more" bindtap="goToRanking">
          <text>更多排行榜</text>
          <text class="rank-arrow">›</text>
        </view>
      </view>

      <view class="list-card" wx:if="{{rankingList.length > 0}}">
        <view class="list-item" wx:for="{{rankingList}}" wx:key="fundCode">
          <text class="item-rank">{{item.rank}}</text>
          <view class="item-name" bindtap="goToFundDetail" data-code="{{item.fundCode}}">
            <text>{{item.fundName}}</text>
            <text class="item-code">{{item.fundCode}}</text>
          </view>
          <text class="item-value {{item.isUp ? 'up' : 'down'}}" bindtap="goToFundDetail" data-code="{{item.fundCode}}">{{item.changeText}}</text>
        </view>
      </view>
      <view class="rank-empty" wx:else>
        <text>暂无排行榜数据</text>
      </view>
    </view>

    <!-- 未登录提示 -->
    <view class="section login-hint" wx:if="{{!loggedIn}}">
      <view class="login-hint-card" bindtap="goToLogin">
        <text class="login-hint-text">登录后查看更多信息</text>
        <text class="login-hint-btn">去登录 ›</text>
      </view>
    </view>
  </block>
</view>
