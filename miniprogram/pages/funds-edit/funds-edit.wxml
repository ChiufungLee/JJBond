<!--pages/funds-edit/funds-edit.wxml-->
<view class="edit-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>
    <!-- 基金信息 -->
    <view class="fund-info-section">
      <view class="fund-info-card">
        <text class="fund-name">{{fundInfo.fund_name}}</text>
        <text class="fund-code">{{fundInfo.fund_code}}</text>
      </view>
    </view>

    <!-- 表单 -->
    <view class="form-section">
      <view class="section-title">修改持仓信息</view>

      <view class="form-item">
        <text class="form-label">成本价</text>
        <input
          class="form-input"
          type="digit"
          placeholder="请输入成本价"
          value="{{cost_price}}"
          bindinput="onCostPriceInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">持有份额</text>
        <input
          class="form-input"
          type="digit"
          placeholder="请输入持有份额"
          value="{{shares}}"
          bindinput="onSharesInput"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button
        class="submit-btn"
        bindtap="handleSubmit"
        loading="{{submitting}}"
        disabled="{{submitting}}"
      >
        保存修改
      </button>
    </view>
  </block>
</view>
