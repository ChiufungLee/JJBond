/* pages/funds-edit/funds-edit.wxss */
.edit-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 基金信息 */
.fund-info-section {
  margin-bottom: 24rpx;
}

.fund-info-card {
  background-color: #722ed1;
  border-radius: 16rpx;
  padding: 32rpx;
  color: #ffffff;
}

.fund-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.fund-code {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 表单区域 */
.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 48rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.7;
}
