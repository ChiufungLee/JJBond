/* pages/watchlist/watchlist.wxss */
.watchlist-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 搜索区域 */
.search-section {
  padding: 24rpx;
  background-color: #722ed1;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 搜索结果 */
.search-results {
  padding: 24rpx;
}

.result-list {
  /* 容器 */
}

.result-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 基金信息 */
.result-item .item-info {
  flex: 1;
  overflow: hidden;
}

.result-item .item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.result-item .item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.result-item .item-type {
  font-size: 20rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.result-item .item-meta {
  display: flex;
  align-items: center;
}

.result-item .item-code {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.result-item .item-action {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.result-item .btn-add {
  font-size: 48rpx;
  color: #722ed1;
  padding: 0 16rpx;
  line-height: 1;
}

/* 搜索中状态 */
.searching-state, .no-result-state {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
  background-color: #fff;
}

/* 自选区域 */
.watchlist-section {
  padding: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* 自选列表 */
.watchlist-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0;
}

/* 表头 */
.list-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* 列表内容 */
.list-body {
  max-height: 60vh;
  overflow-y: auto;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

/* 列宽度 */
.col-info {
  flex: 2;
  min-width: 0;
}

.col-today {
  flex: 1.2;
  text-align: center;
}

.col-total {
  flex: 1.2;
  text-align: center;
}

.col-action {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 基金信息 */
.col-info .item-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.col-info .item-code {
  font-size: 22rpx;
  color: #999;
}

.item-holding {
  font-size: 20rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 涨跌幅 */
.col-today text,
.col-total text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}

/* 移除按钮 */
.btn-remove {
  font-size: 48rpx;
  color: #722ed1;
  line-height: 1;
}
