<!--pages/watchlist/watchlist.wxml-->
<view class="watchlist-container">
  <!-- 搜索框 -->
  <view wx:if="{{loggedIn}}" class="search-section">
    <view class="search-box">
      <image class="search-icon" src="/icons/search.svg" mode="aspectFit"></image>
      <input
        class="search-input"
        type="text"
        placeholder="搜索基金代码或名称添加自选"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
      />
    </view>
  </view>

  <!-- 搜索结果 -->
  <view wx:if="{{searchKeyword && searchResults.length > 0}}" class="search-results">
    <view class="result-list">
      <view class="result-item" wx:for="{{searchResults}}" wx:key="fund_code">
        <!-- 基金信息 -->
        <view class="item-info" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <view class="item-header">
            <text class="item-name">{{item.fund_name}}</text>
            <text class="item-type" wx:if="{{item.fund_type}}">{{item.fund_type}}</text>
          </view>
          <view class="item-meta">
            <text class="item-code">{{item.fund_code}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="item-action">
          <view
            class="btn-add"
            catchtap="addToWatchlist"
            data-code="{{item.fund_code}}"
            data-name="{{item.fund_name}}"
          >+</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索中状态 -->
  <view wx:elif="{{searching}}" class="searching-state">
    <text>搜索中...</text>
  </view>

  <!-- 无搜索结果 -->
  <view wx:elif="{{searchKeyword && !searching && searchResults.length === 0}}" class="no-result-state">
    <text>未找到相关基金</text>
  </view>

  <!-- 热搜基金 -->
  <view wx:if="{{loggedIn && searchFocused && !searchKeyword && hotFunds.length > 0}}" class="hot-search-section">
    <view class="hot-search-title">
      <text class="hot-search-header-name">🔥 热搜基金</text>
      <text class="hot-search-header-rate">近一年涨幅</text>
      <text class="hot-search-header-action">添加自选</text>
    </view>
    <scroll-view
      class="hot-search-list"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      style="max-height: 60vh;"
      bindscroll="onHotListScroll"
      bindtouchstart="onHotListTouchStart"
      bindtouchend="onHotListTouchEnd"
    >
      <view
        class="hot-search-item"
        wx:for="{{hotFunds}}"
        wx:key="fund_code"
      >
        <view class="hot-item-info" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <text class="hot-fund-name">{{item.fund_name}}</text>
          <text class="hot-fund-rate {{item.rate_class}}">{{item.return_rate}}</text>
        </view>
        <view class="hot-item-action">
          <view
            class="btn-add"
            catchtap="addToWatchlist"
            data-code="{{item.fund_code}}"
            data-name="{{item.fund_name}}"
          >+</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 未登录提示 -->
  <view wx:if="{{!searchKeyword && !loggedIn}}" class="empty-state" bindtap="goToLogin">
    <text class="empty-icon">⭐</text>
    <text class="empty-text">暂无基金</text>
    <text class="empty-hint">登录后查看您的自选基金</text>
  </view>

  <!-- 自选列表 -->
  <view wx:if="{{loggedIn && !searchKeyword}}" class="watchlist-section">
    <view class="section-header">
      <text class="section-title">我的自选 ({{watchlist.length}})</text>
    </view>

    <!-- demo 数据提示 -->
    <view wx:if="{{isDemo}}" class="demo-tip" bindtap="goToSearch">
      <text class="demo-tip-text">以下为示例数据，添加自选后展示真实基金</text>
      <text class="demo-tip-btn">去添加 ›</text>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{loggedIn && watchlist.length === 0}}" class="empty-state">
      <text class="empty-icon">⭐</text>
      <text class="empty-text">暂无自选基金</text>
      <text class="empty-hint">搜索或从排行榜页面添加</text>
    </view>

    <!-- 自选列表 -->
    <view wx:else class="watchlist-list">
      <!-- 表头 -->
      <view class="list-header">
        <text class="col-info">基金信息</text>
        <view class="col-today col-sortable {{sortField === 'change_rate' ? 'active' : ''}}" bindtap="sortByToday">
          <text>今日涨幅</text>
          <view class="sort-icons">
            <text class="sort-icon sort-asc {{sortField === 'change_rate' && sortOrder === 'asc' ? 'active' : ''}}">▲</text>
            <text class="sort-icon sort-desc {{sortField === 'change_rate' && sortOrder === 'desc' ? 'active' : ''}}">▼</text>
          </view>
        </view>
        <view class="col-total col-sortable {{sortField === 'total_change_rate' ? 'active' : ''}}" bindtap="sortByTotal">
          <text>自选以来</text>
          <view class="sort-icons">
            <text class="sort-icon sort-asc {{sortField === 'total_change_rate' && sortOrder === 'asc' ? 'active' : ''}}">▲</text>
            <text class="sort-icon sort-desc {{sortField === 'total_change_rate' && sortOrder === 'desc' ? 'active' : ''}}">▼</text>
          </view>
        </view>
        <text class="col-action" wx:if="{{loggedIn}}">移除</text>
      </view>

      <!-- 列表内容 -->
      <view class="list-body">
        <view class="list-item" wx:for="{{watchlist}}" wx:key="id">
          <!-- 基金信息 -->
          <view class="col-info" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
            <text class="item-name">{{item.fund_name}}</text>
            <view class="item-meta">
              <text class="item-code">{{item.fund_code}}</text>
              <text wx:if="{{item.nav_updated}}" class="item-holding">已更新</text>
              <text class="item-holding" wx:if="{{item.is_holding}}">已持有</text>
            </view>
          </view>

          <!-- 今日涨幅 -->
          <view class="col-today {{item.change_rate_class}}" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
            <text class="rate-value">{{item.change_rate || '--'}}</text>
          </view>

          <!-- 自选以来涨幅 -->
          <view class="col-total {{item.total_change_rate >= 0 ? 'up' : 'down'}}" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
            <text class="rate-value">{{item.total_change_formatted || '--'}}</text>
          </view>

          <!-- 移除按钮 -->
          <view class="col-action" wx:if="{{loggedIn}}">
            <view
              class="btn-remove"
              catchtap="removeFromWatchlist"
              data-id="{{item.id}}"
              data-name="{{item.fund_name}}"
            >-</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
