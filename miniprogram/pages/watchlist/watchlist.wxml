<!--pages/watchlist/watchlist.wxml-->
<view class="watchlist-container">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索基金代码或名称添加自选"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 搜索结果 -->
  <view wx:if="{{searchKeyword && searchResults.length > 0}}" class="search-results">
    <view class="result-list">
      <view class="result-item" wx:for="{{searchResults}}" wx:key="fund_code">
        <view class="result-main">
          <view class="result-info">
            <text class="result-name">{{item.fund_name}}</text>
            <text class="result-code">{{item.fund_code}}</text>
          </view>
          <text class="result-type">{{item.fund_type || '其他'}}</text>
        </view>
        <view class="result-action">
          <button class="btn-add" catchtap="addToWatchlist" data-code="{{item.fund_code}}" data-name="{{item.fund_name}}">+ 加自选</button>
          <button class="btn-buy" catchtap="goToAddFund" data-code="{{item.fund_code}}" data-name="{{item.fund_name}}">买入</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索中状态 -->
  <view wx:elif="{{searching}}" class="searching-state">
    <text>搜索中...</text>
  </view>

  <!-- 无搜索结果 -->
  <view wx:elif="{{searchKeyword && !searching && searchResults.length === 0}}" class="no-result-state">
    <text>未找到相关基金</text>
  </view>

  <!-- 自选列表 -->
  <view wx:if="{{!searchKeyword}}" class="watchlist-section">
    <view class="section-header">
      <text class="section-title">我的自选 ({{watchlist.length}})</text>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{watchlist.length === 0}}" class="empty-state">
      <text class="empty-icon">⭐</text>
      <text class="empty-text">暂无自选基金</text>
      <text class="empty-hint">搜索上方添加自选</text>
    </view>

    <!-- 自选列表 -->
    <view wx:else class="watchlist-list">
      <view class="watchlist-item" wx:for="{{watchlist}}" wx:key="id">
        <view class="item-main" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <view class="item-header">
            <text class="item-name">{{item.fund_name}}</text>
            <view class="item-tags">
              <text wx:if="{{item.is_holding}}" class="tag tag-holding">持有</text>
            </view>
          </view>
          <view class="item-info">
            <text class="item-code">{{item.fund_code}}</text>
            <text class="item-date">{{item.added_at_formatted}}加入</text>
          </view>
        </view>
        <view class="item-data">
          <view class="data-row">
            <text class="data-label">当前净值</text>
            <text class="data-value">{{item.current_nav || '--'}}</text>
          </view>
          <view class="data-row">
            <text class="data-label">今日涨跌</text>
            <text class="data-change {{item.change_rate && item.change_rate.indexOf('-') >= 0 ? 'down' : 'up'}}">{{item.change_rate || '--'}}</text>
          </view>
          <view class="data-row">
            <text class="data-label">自选涨幅</text>
            <text class="data-change {{item.total_change_rate >= 0 ? 'up' : 'down'}}">
              {{item.total_change_rate >= 0 ? '+' : ''}}{{item.total_change_formatted}}
            </text>
          </view>
        </view>
        <view class="item-actions">
          <button wx:if="{{!item.is_holding}}" class="btn-action btn-buy" catchtap="goToAddFund" data-code="{{item.fund_code}}" data-name="{{item.fund_name}}">买入</button>
          <button wx:else class="btn-action btn-disabled" disabled>已持有</button>
          <button class="btn-action btn-remove" catchtap="removeFromWatchlist" data-id="{{item.id}}" data-name="{{item.fund_name}}">移除</button>
        </view>
      </view>
    </view>
  </view>
</view>
