/* pages/funds/funds.wxss */
.funds-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

.btn-add {
  background-color: #722ed1;
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 基金表格 */
.fund-table {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 表头 */
.table-header {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* 表格内容 */
.table-body {
  max-height: 70vh;
  overflow-y: auto;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

/* 列宽度 */
.col-info {
  flex: 2.5;
  min-width: 0;
}

.col-cost {
  flex: 1.5;
  text-align: right;
}

.col-price {
  flex: 1.2;
  text-align: right;
}

.col-shares {
  flex: 1.5;
  text-align: right;
}

.col-action {
  width: 140rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 基金信息 */
.col-info .fund-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.col-info .fund-code {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 数值显示 */
.col-cost text,
.col-price text,
.col-shares text {
  font-size: 26rpx;
  color: #333;
}

/* 操作按钮 */
.col-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.action-btn.edit {
  color: #722ed1;
  background-color: #f9f0ff;
}

.action-btn.delete {
  color: #ff4d4f;
  background-color: #fff1f0;
}

/* 添加按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.add-btn::after {
  border: none;
}
