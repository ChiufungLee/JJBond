/* pages/funds/funds.wxss */
.funds-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 24rpx 0;
}

.sector-pie-card {
  margin-top: 24rpx;
}

/* 持仓分布卡片 */
.pie-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 扇形图表 */
.pie-section {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.pie-chart-wrap {
  flex-shrink: 0;
  margin-right: 32rpx;
}

.pie-chart {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-total-label {
  font-size: 20rpx;
  color: #999;
}

.pie-total-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.pie-legend {
  flex: 1;
  min-width: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.legend-item:last-child {
  margin-bottom: 0;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.legend-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-pct {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 12rpx;
}
