/* pages/funds/funds.wxss */
.funds-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

.btn-add {
  background-color: #722ed1;
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 基金表格 */
.fund-table {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 表头 */
.table-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* 表格内容 */
.table-body {
  /* 取消固定高度，列表自适应内容 */
}

.table-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

/* 列宽度 */
.col-info {
  flex: 2;
  min-width: 0;
}

.col-total {
  flex: 1.5;
  text-align: center;
}

.col-sortable {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.sort-icons {
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
  line-height: 1;
}

.sort-icons .sort-icon {
  font-size: 16rpx;
  color: #999;
  line-height: 1;
}

.sort-icon.sort-asc {
  margin-bottom: 2rpx;
}

.sort-icon.active {
  color: #722ed1;
}

.col-action {
  width: 120rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 基金信息 */
.col-info .fund-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.fund-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fund-cost {
  font-size: 22rpx;
  color: #999;
}

.fund-rate {
  font-size: 22rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background-color: #f5f5f5;
}

.fund-rate.up {
  color: #ff4d4f;
  background-color: #fff1f0;
}

.fund-rate.down {
  color: #52c41a;
  background-color: #f6ffed;
}

/* 持有收益 */
.col-total text {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
}

.profit-rate {
  font-size: 22rpx !important;
  font-weight: normal !important;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}

/* 操作按钮 */
.col-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: #722ed1;
  background-color: #f9f0ff;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
}

.hide-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
}

.hide-btn .eye-icon {
  width: 36rpx;
  height: 36rpx;
}

.hide-btn text {
  font-size: 26rpx;
  color: #666;
}

.add-btn {
  flex: 1;
  height: 80rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.add-btn::after {
  border: none;
}
