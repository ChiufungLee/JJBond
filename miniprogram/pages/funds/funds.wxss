/* pages/funds/funds.wxss */
.funds-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

.btn-add {
  background-color: #722ed1;
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 基金列表 */
.fund-list {
  margin-top: 16rpx;
}

.fund-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.fund-main {
  padding: 28rpx 24rpx;
}

.fund-info {
  margin-bottom: 20rpx;
}

.fund-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fund-code {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.fund-data {
  display: flex;
  justify-content: space-between;
}

.fund-row {
  flex: 1;
}

.fund-row .label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.fund-row .value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.fund-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.fund-actions button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 0;
  border: none;
  background: transparent;
  margin: 0;
  padding: 0;
}

.fund-actions button::after {
  border: none;
}

.btn-edit {
  color: #722ed1;
  border-right: 1rpx solid #f0f0f0 !important;
}

.btn-delete {
  color: #ff4d4f;
}

/* 添加按钮 */
.add-btn-wrapper {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.add-btn::after {
  border: none;
}
