<!--pages/funds/funds.wxml-->
<view class="funds-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{funds.length === 0}}" class="empty-state">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无持仓基金</text>
    <button class="btn-add" bindtap="goToAddFund">添加基金</button>
  </view>

  <!-- 基金表格 -->
  <view wx:else class="fund-table">
    <!-- 表头 -->
    <view class="table-header">
      <text class="col-info">基金信息</text>
      <text class="col-cost">持仓成本</text>
      <text class="col-price">成本价</text>
      <text class="col-shares">份额</text>
      <text class="col-action">操作</text>
    </view>

    <!-- 表格内容 -->
    <view class="table-body">
      <view class="table-row" wx:for="{{funds}}" wx:key="id">
        <view class="col-info" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <text class="fund-name">{{item.fund_name}}</text>
          <text class="fund-code">{{item.fund_code}}</text>
        </view>
        <view class="col-cost" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <text>{{item.cost_formatted}}</text>
        </view>
        <view class="col-price" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <text>{{item.cost_price_formatted}}</text>
        </view>
        <view class="col-shares" bindtap="goToFundDetail" data-code="{{item.fund_code}}">
          <text>{{item.shares_formatted}}</text>
        </view>
        <view class="col-action">
          <text class="action-btn edit" catchtap="goToEditFund" data-id="{{item.id}}">编辑</text>
          <text class="action-btn delete" catchtap="deleteFund" data-id="{{item.id}}" data-name="{{item.fund_name}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn-wrapper" wx:if="{{!loading && funds.length > 0}}">
    <button class="add-btn" bindtap="goToAddFund">+ 添加基金</button>
  </view>
</view>
