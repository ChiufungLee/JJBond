<!--pages/funds/funds.wxml-->
<view class="funds-container">
  <loading wx:if="{{loading}}" text="加载中..."></loading>

  <empty
    wx:elif="{{error}}"
    icon="⚠️"
    text="{{errorMessage || '加载持仓列表失败，请稍后重试'}}"
    showButton="{{true}}"
    buttonText="重新加载"
    bind:buttonTap="loadFunds"
  ></empty>

  <empty
    wx:elif="{{!loggedIn}}"
    icon="🔐"
    text="登录后查看您的持仓"
    showButton="{{true}}"
    buttonText="去登录"
    bind:buttonTap="goToLogin"
  ></empty>

  <empty
    wx:elif="{{funds.length === 0}}"
    icon="📊"
    text="暂无持仓基金"
  ></empty>

  <!-- 持仓分布饼图 -->
  <view wx:elif="{{pieData}}" class="pie-card">
    <view class="section-title">资金分布</view>
    <view class="pie-section">
      <view class="pie-chart-wrap">
        <view class="pie-chart" style="background: {{pieData.gradient}}">
          <view class="pie-inner">
            <text class="pie-total-label">持有基金</text>
            <text class="pie-total-value">{{funds.length}}只</text>
          </view>
        </view>
      </view>
      <view class="pie-legend">
        <view class="legend-item" wx:for="{{pieData.legend}}" wx:key="name">
          <view class="legend-dot" style="background: {{item.color}}"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-pct">{{item.pct}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 板块分布饼图 -->
  <view wx:if="{{sectorPieData}}" class="pie-card sector-pie-card">
    <view class="section-title">板块分布</view>
    <view class="pie-section">
      <view class="pie-chart-wrap">
        <view class="pie-chart" style="background: {{sectorPieData.gradient}}">
          <view class="pie-inner">
            <text class="pie-total-label">板块数</text>
            <text class="pie-total-value">{{sectorPieData.legend.length}}个</text>
          </view>
        </view>
      </view>
      <view class="pie-legend">
        <view class="legend-item" wx:for="{{sectorPieData.legend}}" wx:key="name">
          <view class="legend-dot" style="background: {{item.color}}"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-pct">{{item.pct}}%</text>
        </view>
      </view>
    </view>
  </view>
</view>
