<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!summary || summary.fund_count === 0}}" class="empty-state">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无持仓基金</text>
    <button class="btn-add" bindtap="goToAddFund">添加基金</button>
  </view>

  <!-- 数据展示 -->
  <block wx:else>
    <!-- 收益概览卡片 -->
    <view class="summary-card">
      <view class="summary-header">
        <text class="greeting {{summary.today_revenue >= 0 ? 'up' : 'down'}}">{{summary.today_revenue >= 0 ? '恭喜发财！' : '请开心起来！'}}</text>
        <text class="summary-title">今日收益</text>
      </view>
      <view class="summary-content">
        <view class="revenue-amount {{summary.today_revenue >= 0 ? 'up' : 'down'}}">
          <text>{{summary.today_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : summary.today_revenue_formatted}}</text>
          <view class="eye-icon" bindtap="toggleHideAmount">
            <view class="eye-shape">
              <view class="eye-pupil"></view>
            </view>
            <view class="eye-slash" wx:if="{{hideAmount}}"></view>
          </view>
        </view>
      </view>
      <view class="summary-footer">
        <view class="summary-item">
          <text class="label">总成本</text>
          <text class="value">{{hideAmount ? '****' : summary.total_cost_formatted}}</text>
        </view>
        <view class="summary-item">
          <text class="label">总收益</text>
          <text class="value {{summary.total_revenue >= 0 ? 'up' : 'down'}}">{{summary.total_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : summary.total_revenue_formatted}}</text>
        </view>
      </view>
    </view>

    <!-- 涨跌榜 -->
    <view class="rank-section" wx:if="{{summary.high_fund_list.length > 0 || summary.low_fund_list.length > 0}}">
      <view class="section-header">
        <text class="section-title">涨跌幅度大于3%的基金</text>
      </view>

      <!-- 涨幅榜 -->
      <view class="rank-card" wx:if="{{summary.high_fund_list.length > 0}}">
        <view class="rank-list">
          <view class="rank-item up" wx:for="{{summary.high_fund_list}}" wx:key="*this">
            <text class="rank-fund">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 跌幅榜 -->
      <view class="rank-card" wx:if="{{summary.low_fund_list.length > 0}}">
        <view class="rank-list">
          <view class="rank-item down" wx:for="{{summary.low_fund_list}}" wx:key="*this">
            <text class="rank-fund">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 持仓列表 -->
    <view class="fund-list-section">
      <view class="section-header">
        <view class="section-title-row">
          <text class="section-title">持仓信息 ({{summary.fund_count}})</text>
          <text class="section-time">统计于 {{summary.update_time || '2026-03-18 22:51:00'}}</text>
        </view>
        <text class="section-more" bindtap="goToAddFund">+ 添加</text>
      </view>

      <view class="fund-list">
        <!-- 表头 -->
        <view class="list-header">
          <text class="header-col">基金信息</text>
          <view
            class="header-col sortable {{sortBy === 'today_revenue' ? 'active' : ''}}"
            bindtap="handleSort"
            data-field="today_revenue"
          >
            <text>当日收益</text>
            <view class="sort-icons">
              <text class="sort-icon sort-asc {{sortBy === 'today_revenue' && sortOrder === 'asc' ? 'active' : ''}}">▲</text>
              <text class="sort-icon sort-desc {{sortBy === 'today_revenue' && sortOrder === 'desc' ? 'active' : ''}}">▼</text>
            </view>
          </view>
          <view
            class="header-col sortable {{sortBy === 'total_revenue' ? 'active' : ''}}"
            bindtap="handleSort"
            data-field="total_revenue"
          >
            <text>持有收益</text>
            <view class="sort-icons">
              <text class="sort-icon sort-asc {{sortBy === 'total_revenue' && sortOrder === 'asc' ? 'active' : ''}}">▲</text>
              <text class="sort-icon sort-desc {{sortBy === 'total_revenue' && sortOrder === 'desc' ? 'active' : ''}}">▼</text>
            </view>
          </view>
        </view>

        <view
          class="fund-item"
          wx:for="{{summary.fund_details}}"
          wx:key="fund_code"
          bindtap="goToFundDetail"
          data-code="{{item.fund_code}}"
        >
          <view class="fund-row">
            <text class="fund-name">{{item.fund_name}}</text>
            <text class="fund-value {{item.today_revenue >= 0 ? 'up' : 'down'}}">{{item.today_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : item.today_revenue_formatted}}</text>
            <text class="fund-value {{item.total_revenue >= 0 ? 'up' : 'down'}}">{{item.total_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : item.total_revenue_formatted}}</text>
          </view>
          <view class="fund-row">
            <text class="fund-cost">{{hideAmount ? '￥****' : '￥' + item.cost_formatted}}</text>
            <text class="fund-rate {{item.today_revenue >= 0 ? 'up' : 'down'}}">{{item.change_rate}}</text>
            <text class="fund-rate {{item.profit_loss_ratio >= 0 ? 'up' : 'down'}}">{{item.profit_loss_ratio_formatted}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
