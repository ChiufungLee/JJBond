/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 未登录示例数据提示横幅 */
.demo-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 12rpx;
}

.demo-banner-text {
  font-size: 26rpx;
  color: #d48806;
}

.demo-banner-btn {
  font-size: 26rpx;
  color: #722ed1;
  font-weight: 500;
}

/* demo 数据提示 */
.demo-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-radius: 12rpx;
}

.demo-tip-text {
  font-size: 24rpx;
  color: #d48806;
}

.demo-tip-btn {
  font-size: 24rpx;
  color: #722ed1;
  font-weight: 500;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}

.btn-add {
  background-color: #722ed1;
  color: #ffffff;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 收益概览卡片 */
.summary-card {
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
}

.greeting {
  font-size: 36rpx;
  font-weight: 500;
}

.greeting.up {
  color: #ff4d4f;
}

.greeting.down {
  color: #52c41a;
}

.eye-icon {
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
  filter: brightness(0) invert(1);
}

.summary-content {
  margin-bottom: 32rpx;
  display: flex;
  justify-content: flex-end;
}

.revenue-amount {
  font-size: 64rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.revenue-amount text {
  margin-right: 12rpx;
}

.summary-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-item .label {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.summary-item .value {
  font-size: 28rpx;
  font-weight: 500;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}

/* 涨跌榜 */
.rank-section {
  margin: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-title-row {
  display: flex;
  align-items: baseline;
}

.section-time {
  font-size: 20rpx;
  color: #999;
  margin-left: 12rpx;
}

.section-more {
  font-size: 26rpx;
  color: #722ed1;
}

.rank-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.rank-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.rank-title.up {
  color: #ff4d4f;
}

.rank-title.down {
  color: #52c41a;
}

.rank-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.rank-list {
  display: flex;
  flex-wrap: wrap;
}

.rank-item {
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.rank-item.up .rank-fund {
  background-color: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.rank-item.down .rank-fund {
  background-color: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.rank-fund {
  font-size: 24rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* 持仓列表 */
.fund-list-section {
  margin: 24rpx;
}

.fund-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 表头 */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-col {
  width: 160rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.header-col:first-child {
  flex: 1;
  text-align: left;
}

/* 可排序表头 */
.header-col.sortable {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.header-col.sortable.active {
  color: #722ed1;
  font-weight: 500;
}

.sort-icons {
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
  line-height: 1;
}

.sort-icon {
  font-size: 16rpx;
  color: #999;
  line-height: 1;
}

.sort-icon.sort-asc {
  margin-bottom: 2rpx;
}

.sort-icon.active {
  color: #722ed1;
}

.fund-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.fund-item:last-child {
  border-bottom: none;
}

.fund-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.fund-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.fund-cost {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

.fund-value {
  width: 160rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
}

.fund-rate {
  width: 160rpx;
  text-align: right;
  font-size: 24rpx;
}

.nav-updated-tag {
  font-size: 16rpx;
  font-weight: 400;
  color: #fff;
  background-color: #722ed1;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}
