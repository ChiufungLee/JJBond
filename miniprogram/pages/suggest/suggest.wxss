.suggest-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.suggest-header {
  padding: 32rpx 16rpx;
}

.suggest-header-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
}

.suggest-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.suggest-textarea {
  width: 100%;
  height: 300rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.suggest-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.suggest-btn {
  margin-top: 40rpx;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
  padding: 24rpx 0;
}

.suggest-btn[disabled] {
  background-color: #d9d9d9;
  color: #fff;
}