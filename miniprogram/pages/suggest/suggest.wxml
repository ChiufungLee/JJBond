<view class="suggest-container">
  <view class="suggest-header">
    <text class="suggest-header-text">感谢你的宝贵建议，我们一起变得更好~</text>
  </view>

  <view class="suggest-card">
    <textarea
      class="suggest-textarea"
      placeholder="请输入你的建议..."
      maxlength="300"
      value="{{content}}"
      bindinput="onInput"
    ></textarea>
    <text class="suggest-count">{{count}}/300</text>
  </view>

  <button class="suggest-btn" bindtap="handleSubmit" disabled="{{!canSubmit || submitting}}">
    {{submitting ? '提交中...' : '提交建议'}}
  </button>
</view>