<!--pages/profile-edit/profile-edit.wxml-->
<view class="edit-container">
  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="nickname"
        placeholder="点击获取微信昵称"
        value="{{nickname}}"
        bindblur="onNicknameInput"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>
    <view class="form-hint">
      <text>点击输入框可获取微信昵称</text>
    </view>
  </view>

  <button
    class="btn-save"
    bindtap="handleSave"
    loading="{{loading}}"
    disabled="{{loading || !canSubmit}}"
  >
    保存
  </button>
</view>
