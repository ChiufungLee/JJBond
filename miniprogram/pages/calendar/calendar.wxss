/* pages/calendar/calendar.wxss */
.calendar-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header-section {
  background-color: #722ed1;
  border-radius: 32rpx;
  padding-top: 24rpx;
  margin: 24rpx;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 24rpx;
  border-color: #ccc;
}

.selector-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selector-btn text {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
}

.selector-title {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.selector-title .year {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.selector-title .month {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

/* 月度统计 */
.month-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 40rpx 40rpx;
  margin-top: 16rpx;
  position: relative;
}

.month-summary::before {
  content: '';
  position: absolute;
  top: 0;
  left: 5%;
  width: 80%;
  height: 1rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
  line-height: 1.2;
  min-height: 56rpx;
}

.summary-value.positive {
  color: #ff6b6b;
}

.summary-value.negative {
  color: #52c41a;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

/* 日历主体 */
.calendar-body {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 星期标题 */
.week-header {
  display: flex;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.week-item {
  width: 14.285%;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 日期网格 */
.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-item {
  width: 14.285%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.day-item.empty {
  padding: 12rpx 4rpx;
}

.day-number {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.day-revenue {
  font-size: 18rpx;
  color: #999;
}

.day-revenue .no-data {
  color: #ccc;
}

.day-weekend {
  font-size: 18rpx;
  color: #ccc;
}

/* 交易日样式 - 盈利 */
.day-item.positive {
  background-color: rgba(255, 77, 79, 0.1);
}

.day-item.positive .day-number {
  color: #ff4d4f;
}

.day-item.positive .day-revenue {
  color: #ff4d4f;
}

/* 交易日样式 - 亏损 */
.day-item.negative {
  background-color: rgba(82, 196, 26, 0.1);
}

.day-item.negative .day-number {
  color: #52c41a;
}

.day-item.negative .day-revenue {
  color: #52c41a;
}

/* 周末样式 */
.day-item.weekend {
  opacity: 0.6;
}

.day-item.weekend .day-number {
  color: #999;
}

/* 今天样式 */
.day-item.today .day-number {
  position: relative;
  color: #722ed1;
  font-weight: 500;
}

.day-item.today .day-number::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 0;
  right: 0;
  width: 100%;
  height: 4rpx;
  background-color: #722ed1;
  border-radius: 2rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}

/* 当天收益明细 */
.today-detail {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.detail-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.detail-sort {
  font-size: 24rpx;
  color: #999;
}

.detail-list {
  padding: 0 28rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-fund-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.detail-value {
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}

/* ── 选中日期样式 ── */
.day-item.selected {
  background-color: #722ed1;
  border-radius: 12rpx;
}

.day-item.selected .day-number {
  color: #fff;
  font-weight: 600;
}

.day-item.selected .day-revenue,
.day-item.selected .day-revenue text,
.day-item.selected .day-weekend {
  color: rgba(255, 255, 255, 0.85);
}

/* 选中态覆盖今天的下划线伪元素 */
.day-item.selected.today .day-number::after {
  background-color: rgba(255, 255, 255, 0.6);
}

/* ── 选中日期收益明细卡片 ── */
.day-detail {
  margin: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.detail-header {
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.detail-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.detail-date {
  font-size: 24rpx;
  font-weight: normal;
  color: #999;
  display: inline;
}

.detail-revenue-inline {
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.detail-tag {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.detail-revenue-badge {
  font-size: 30rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
}

.detail-revenue-badge.badge-up {
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
}

.detail-revenue-badge.badge-down {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.08);
}

.detail-revenue-badge.badge-flat {
  color: #999;
  background: #f5f5f5;
}

.detail-no-revenue {
  font-size: 26rpx;
  color: #bbb;
}

.detail-accumulated {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 基金列表分区标题 */
.detail-section-title {
  padding: 20rpx 24rpx 12rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-section-title text:first-child {
  font-size: 26rpx;
  font-weight: 500;
  color: #555;
}

.detail-section-hint {
  font-size: 22rpx;
  color: #bbb;
}

.detail-nav-change {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
}

.detail-change-rate {
  font-size: 22rpx;
}

.detail-shares {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
  text-align: right;
}

/* 基金列表 */
.detail-list {
  padding: 0 24rpx;
}

.detail-list-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-name {
  flex: 1;
  font-size: 22rpx;
  color: #999;
}

.header-col {
  width: 120rpx;
  text-align: right;
  font-size: 22rpx;
  color: #999;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-fund-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.detail-value {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.detail-rate {
  width: 120rpx;
  text-align: right;
  font-size: 22rpx;
  flex-shrink: 0;
}

.up   { color: #ff4d4f; }
.down { color: #52c41a; }
.flat { color: #999; }

/* 空状态 */
.detail-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}

/* ── 收益树图 ── */
.revenue-chart-wrap {
  margin: 0 24rpx 24rpx;
}

.revenue-chart {
  position: relative;
  width: 100%;
  height: 460rpx;
  border-radius: 12rpx;
  overflow: hidden;
  /* 白色背景作为间距底色，与色块内缩配合产生真实间隔 */
  background-color: #fff;
}

.chart-block {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  box-sizing: border-box;
  padding: 6rpx 4rpx;
  overflow: hidden;
}

.chart-label {
  /* font-size 由 JS 计算后内联注入 */
  display: block;
  font-weight: 500;
  /* color 由 JS textColor 内联注入 */
  text-align: center;
  line-height: 1.4;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-revenue {
  /* font-size 由 JS revenueSize 内联注入 */
  display: block;
  font-weight: 500;
  margin-top: 4rpx;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-legend {
  display: block;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
  padding: 16rpx 24rpx 8rpx;
}
