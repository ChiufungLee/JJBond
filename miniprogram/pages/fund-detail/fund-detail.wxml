<!--pages/fund-detail/fund-detail.wxml-->
<view class="detail-container">
  <loading wx:if="{{loading}}" text="加载中..."></loading>

  <empty
    wx:elif="{{error}}"
    icon="⚠️"
    text="{{errorMessage || '加载基金详情失败，请稍后重试'}}"
    showButton="{{true}}"
    buttonText="{{errorType === 'invalid' ? '返回上一页' : '重新加载'}}"
    bind:buttonTap="handleErrorAction"
  ></empty>

  <block wx:elif="{{fundInfo}}">
    <!-- 基金基本信息 -->
    <view class="info-card">
      <view class="fund-header">
        <view class="fund-title">
          <text class="fund-name">{{fundInfo.fund_name}}</text>
          <text class="fund-code">{{fundInfo.fund_code}}</text>
        </view>
        <view class="fund-rate {{fundInfo.today_revenue >= 0 ? 'up' : 'down'}}">{{fundInfo.change_rate}}<text wx:if="{{fundInfo.nav_updated}}" class="nav-updated-tag">已更新</text></view>
      </view>

      <view class="fund-main" wx:if="{{isHeld}}">
        <view class="revenue-section">
          <view class="revenue-label">累计收益</view>
          <view class="revenue-value {{fundInfo.total_revenue >= 0 ? 'up' : 'down'}}">{{fundInfo.total_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : fundInfo.total_revenue_formatted}}</view>
        </view>

        <view class="divider"></view>

        <view class="revenue-section">
          <view class="revenue-label">今日收益</view>
          <view class="revenue-value {{fundInfo.today_revenue >= 0 ? 'up' : 'down'}}">
            <text>{{fundInfo.today_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : fundInfo.today_revenue_formatted}}</text>
            <image
              class="eye-icon white"
              src="{{hideAmount ? '/icons/eyes_hidden.svg' : '/icons/eyes_display.svg'}}"
              mode="aspectFit"
              bindtap="toggleHideAmount"
            ></image>
          </view>
        </view>
      </view>

      <!-- 未持有基金显示今日估值 -->
      <view class="fund-main" wx:else>
        <view class="revenue-section">
          <view class="revenue-label">{{fundInfo.nav_updated ? '今日净值' : '今日估值'}}</view>
          <view class="revenue-value">{{fundInfo.today_value}}</view>
        </view>
      </view>
    </view>

    <!-- 持仓信息（仅持有基金显示） -->
    <view class="section" wx:if="{{isHeld}}">
      <view class="section-title">持仓信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">购买金额</text>
          <text class="info-value">{{hideAmount ? '****' : fundInfo.cost_formatted}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">持有份额</text>
          <text class="info-value">{{hideAmount ? '****' : fundInfo.shares}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">持仓成本</text>
          <text class="info-value">{{hideAmount ? '****' : fundInfo.cost_price}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">{{fundInfo.nav_updated ? '今日净值' : '今日估值'}}</text>
          <text class="info-value {{fundInfo.today_value_trend_class}}">{{fundInfo.today_value}}<block wx:if="{{fundInfo.today_revenue_trend === 'up'}}"> ↑</block><block wx:elif="{{fundInfo.today_revenue_trend === 'down'}}"> ↓</block></text>
        </view>
        <view class="info-item">
          <text class="info-label">累计收益</text>
          <text class="info-value {{fundInfo.total_revenue >= 0 ? 'up' : 'down'}}">{{fundInfo.total_revenue >= 0 ? '+' : ''}}{{hideAmount ? '****' : fundInfo.total_revenue_formatted}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">收益率</text>
          <text class="info-value {{fundInfo.profit_loss_ratio >= 0 ? 'up' : 'down'}}">{{fundInfo.profit_loss_ratio_formatted}}</text>
        </view>
      </view>
    </view>

    <!-- 净值走势图 -->
    <view class="section">
      <view class="section-title">近期净值走势</view>
      <view class="range-tabs">
        <view
          wx:for="{{navRanges}}"
          wx:key="key"
          class="range-tab {{currentNavRange === item.key ? 'active' : ''}}"
          data-range="{{item.key}}"
          bindtap="handleRangeChange"
        >
          {{item.label}}
        </view>
      </view>
      <view class="chart-info">
        <text class="cost-price-label" wx:if="{{isHeld && fundInfo.cost_price}}">-- 成本价: {{hideAmount ? '****' : fundInfo.cost_price}}</text>
        <text class="cost-price-label" wx:else>-- 成本价: --</text>
        <text class="{{tooltip.show ? 'info-highlight' : ''}}">— 净值: {{tooltip.value}} ({{tooltip.date}})</text>
      </view>
      <loading wx:if="{{navLoading}}" text="加载走势图中..."></loading>
      <empty
        wx:elif="{{navError}}"
        icon="⚠️"
        text="{{navErrorMessage || '加载净值历史失败，请稍后重试'}}"
        showButton="{{true}}"
        buttonText="重新加载"
        bind:buttonTap="reloadNavHistory"
      ></empty>
      <empty
        wx:elif="{{navHistoryAll.length === 0}}"
        icon="📉"
        text="当前范围暂无净值数据"
        showButton="{{false}}"
      ></empty>
      <block wx:else>
        <view class="chart-container">
          <view class="chart-wrapper">
            <canvas type="2d" id="fundChart" class="fund-chart"></canvas>
            <!-- 触摸层 -->
            <view class="chart-overlay" catchtouchstart="handleChartTouchStart" catchtouchmove="handleChartTouchMove" catchtouchend="handleChartTouchEnd"></view>
          </view>
          <!-- 十字光标 -->
          <view class="crosshair-layer" wx:if="{{tooltip.show}}">
            <view class="crosshair-x" style="left: {{tooltip.x}}px;"></view>
            <view class="crosshair-y" style="top: {{tooltip.y}}px;"></view>
            <view class="crosshair-dot" style="left: {{tooltip.x}}px; top: {{tooltip.y}}px;"></view>
          </view>
        </view>
      </block>
    </view>

    <!-- 近期变化 -->
    <view class="section">
      <view class="section-title">近期净值</view>
      <view class="change-list" wx:if="{{navList.length > 0}}">
        <!-- 表头 -->
        <view class="change-header">
          <text class="change-header-item">日期</text>
          <text class="change-header-item">净值</text>
          <text class="change-header-item">涨幅</text>
        </view>
        <!-- 数据行 -->
        <view class="change-item" wx:for="{{navList}}" wx:key="date">
          <text class="change-date">{{item.date}}</text>
          <text class="change-value">{{item.unit_nav}}</text>
          <text class="change-rate {{item.daily_growth_value >= 0 ? 'up' : 'down'}}">{{item.daily_growth}}</text>
        </view>
      </view>
      <empty
        wx:elif="{{navError}}"
        icon="⚠️"
        text="{{navErrorMessage || '加载净值历史失败，请稍后重试'}}"
        showButton="{{true}}"
        buttonText="重新加载"
        bind:buttonTap="reloadNavHistory"
      ></empty>
      <empty
        wx:elif="{{!navLoading}}"
        icon="📉"
        text="当前范围暂无净值数据"
        showButton="{{false}}"
      ></empty>
      <loading wx:if="{{navLoadingMore}}" text="加载更多中..."></loading>
      <view class="list-footer" wx:if="{{!navLoading && !navLoadingMore && navList.length > 0 && !navHasMore}}">
        <text>没有更多了</text>
      </view>
    </view>
  </block>

</view>
