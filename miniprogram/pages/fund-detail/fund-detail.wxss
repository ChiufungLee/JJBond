/* pages/fund-detail/fund-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #999;
  font-size: 30rpx;
}

/* 基金信息卡片 */
.info-card {
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
}

.fund-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.fund-title {
  flex: 1;
}

.fund-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.fund-code {
  font-size: 24rpx;
  opacity: 0.8;
}

.fund-rate {
  font-size: 36rpx;
  font-weight: bold;
}

.fund-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.revenue-section {
  flex: 1;
  text-align: center;
}

.revenue-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 8rpx;
}

.revenue-value {
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.revenue-value text {
  margin-right: 8rpx;
}

/* 眼睛图标 */
.eye-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  filter: brightness(0) invert(1);
}

.divider {
  width: 1rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 通用区块 */
.section {
  background-color: #ffffff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 32rpx 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.info-item:nth-last-child(-n+2) {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 图表 */
.chart-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.chart-info .info-highlight {
  color: #722ed1;
  font-weight: 500;
}

.chart-info .cost-price-label {
  color: #ff7a45;
}

.chart-info .info-highlight text {
  color: #722ed1;
  font-weight: 500;
}

.chart-container {
  position: relative;
  width: 100%;
  height: 200px;
}

.chart-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.fund-chart {
  width: 100%;
  height: 100%;
  display: block;
}

.chart-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.crosshair-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
}

.crosshair-x {
  position: absolute;
  top: 0;
  width: 1px;
  height: 100%;
  background-color: rgba(114, 46, 209, 0.8);
}

.crosshair-y {
  position: absolute;
  left: 0;
  width: 100%;
  height: 1px;
  background-color: rgba(114, 46, 209, 0.8);
}

.crosshair-dot {
  position: absolute;
  width: 12px;
  height: 12px;
  background-color: #722ed1;
  border: 2px solid #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 6px rgba(0, 0, 0, 0.3);
}

/* 近期变化列表 */
.change-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.change-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  background-color: #fafafa;
  border-bottom: 2rpx solid #e8e8e8;
}

.change-header-item {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.change-header-item:first-child {
  text-align: left;
}

.change-header-item:nth-child(2) {
  text-align: center;
}

.change-header-item:last-child {
  text-align: right;
}

.change-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.change-item:last-child {
  border-bottom: none;
}

.change-date {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.change-value {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.change-rate {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}