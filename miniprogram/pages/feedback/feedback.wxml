<!--pages/feedback/feedback.wxml-->
<view class="feedback-container">
  <view class="feedback-card">
    <text class="card-icon">💬</text>
    <text class="card-title">建议反馈</text>
    <text class="card-desc">感谢您的支持，您的反馈是我们前进的动力</text>

    <!-- 使用微信官方反馈按钮 -->
    <button class="feedback-btn" open-type="feedback">
      提交反馈
    </button>
  </view>

  <view class="feedback-tips">
    <text class="tips-title">反馈须知</text>
    <text class="tips-item">• 请详细描述您遇到的问题或建议</text>
    <text class="tips-item">• 如有截图请一并上传</text>
    <text class="tips-item">• 我们会尽快处理您的反馈</text>
  </view>
</view>
