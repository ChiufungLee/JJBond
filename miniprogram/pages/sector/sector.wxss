/* pages/sector/sector.wxss */
.sector-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 涨跌颜色 */
.up { color: #ff4d4f; }
.down { color: #52c41a; }

/* 板块类型切换 */
.type-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.type-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background-color: #722ed1;
  color: #ffffff;
  font-weight: 500;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.time-tabs {
  display: flex;
  gap: 32rpx;
}

.time-tab {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.time-tab.active {
  color: #722ed1;
  font-weight: 600;
}

/* 板块列表 */
.sector-list {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

/* 板块卡片 - 参考行情页指数卡片样式 */
.sector-card {
  width: calc(33.33% - 12rpx);
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  margin-right: 16rpx;
}

.sector-card:nth-child(3n) {
  margin-right: 0;
}

.card-up {
  background: linear-gradient(180deg, #ffccc7 0%, #fff1f0 100%);
}

.card-down {
  background: linear-gradient(180deg, #b7eb8f 0%, #f6ffed 100%);
}

.sector-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
  margin-bottom: 10rpx;
}

.sector-flow {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.sector-change {
  font-size: 20rpx;
}
