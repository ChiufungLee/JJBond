/* pages/sector/sector.wxss */
.sector-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 板块类型切换 */
.type-tabs {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.type-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background-color: #722ed1;
  color: #ffffff;
  font-weight: 500;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sort-tabs {
  display: flex;
  gap: 8rpx;
}

.sort-tab {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background-color: #f5f5f5;
}

.sort-tab.active {
  background-color: #f9f0ff;
  color: #722ed1;
  font-weight: 500;
}

.time-tabs {
  display: flex;
  gap: 4rpx;
}

.time-tab {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.time-tab.active {
  color: #722ed1;
  font-weight: 600;
}

/* 板块列表 */
.sector-list {
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sector-card {
  width: calc(25% - 9rpx);
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 4rpx solid #ffffff;
  border-radius: 16rpx;
}

.sector-card.up {
  background-color: #fff1f0;
}

.sector-card.down {
  background-color: #f6ffed;
}

.sector-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  text-align: center;
}

.sector-value {
  font-size: 30rpx;
  font-weight: 600;
}

.sector-card.up .sector-value {
  color: #ff4d4f;
}

.sector-card.down .sector-value {
  color: #52c41a;
}
