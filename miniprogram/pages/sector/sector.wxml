<!--pages/sector/sector.wxml-->
<view class="sector-container">
  <!-- 板块类型切换 -->
  <view class="type-tabs">
    <view
      wx:for="{{sectorTypes}}"
      wx:key="key"
      class="type-tab {{currentType === item.key ? 'active' : ''}}"
      data-type="{{item.key}}"
      bindtap="onTypeChange"
    >{{item.name}}</view>
  </view>

  <!-- 时间范围 & 排序 -->
  <view class="filter-bar">
    <view class="time-tabs">
      <view
        wx:for="{{timeRanges}}"
        wx:key="key"
        class="time-tab {{currentTime === item.key ? 'active' : ''}}"
        data-time="{{item.key}}"
        bindtap="onTimeChange"
      >{{item.name}}</view>
    </view>
    <view class="sort-btn" bindtap="onSortChange">
      <text>排序</text>
      <view class="sort-icons">
        <text class="sort-icon {{sortOrder === 'asc' ? 'active' : ''}}">▲</text>
        <text class="sort-icon {{sortOrder === 'desc' ? 'active' : ''}}">▼</text>
      </view>
    </view>
  </view>

  <loading wx:if="{{loading && sectorList.length === 0}}" text="加载中..."></loading>

  <empty
    wx:elif="{{error}}"
    icon="⚠️"
    text="{{errorMessage || '加载板块数据失败，请稍后重试'}}"
    showButton="{{true}}"
    buttonText="重新加载"
    bind:buttonTap="loadSectors"
  ></empty>

  <empty
    wx:elif="{{sectorList.length === 0 && !loading}}"
    icon="📊"
    text="暂无板块数据"
    showButton="{{true}}"
    buttonText="重新加载"
    bind:buttonTap="loadSectors"
  ></empty>

  <!-- 板块列表 -->
  <view class="sector-list" wx:if="{{sectorList.length > 0}}">
    <view
      class="sector-card {{item.isUp ? 'card-up' : 'card-down'}}"
      wx:for="{{sectorList}}"
      wx:key="code"
      bindtap="goToSectorFunds"
      data-code="{{item.code}}"
      data-name="{{item.name}}"
    >
      <text class="sector-name">{{item.name}}</text>
      <text class="sector-flow {{item.isUp ? 'up' : 'down'}}">{{item.flowText}}</text>
      <text class="sector-change {{item.isUp ? 'up' : 'down'}}">{{item.changeText}}</text>
    </view>
  </view>

  <loading wx:if="{{loading && sectorList.length > 0}}" text="加载中..."></loading>
</view>
