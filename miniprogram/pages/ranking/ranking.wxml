<!--pages/ranking/ranking.wxml-->
<view class="ranking-container">
  <!-- 类型切换 -->
  <view class="type-tabs">
    <view class="type-tabs-left">
      <view
        wx:for="{{rankingTypes}}"
        wx:key="key"
        class="type-tab {{currentType === item.key ? 'active' : ''}}"
        data-type="{{item.key}}"
        bindtap="onTypeChange"
      >
        {{item.name}}
      </view>
    </view>
    <!-- 排序按钮 -->
    <view class="sort-btn" bindtap="toggleSortOrder">
      <view class="sort-icons">
        <text class="sort-icon sort-asc {{sortOrder === 'asc' ? 'active' : ''}}">▲</text>
        <text class="sort-icon sort-desc {{sortOrder === 'desc' ? 'active' : ''}}">▼</text>
      </view>
    </view>
  </view>

  <!-- 更新时间 -->
  <!-- <view class="update-time" wx:if="{{lastUpdate}}">
    <text>更新时间: {{lastUpdate}}</text>
  </view> -->

  <!-- 排行榜列表 -->
  <view class="ranking-list">
    <view
      class="ranking-item"
      wx:for="{{rankingList}}"
      wx:key="fundCode"
    >
      <!-- 排名 -->
      <view class="item-rank {{item.rank <= 3 ? 'top' : ''}}" bindtap="goToFundDetail" data-code="{{item.fundCode}}">
        <text>{{item.rank}}</text>
      </view>

      <!-- 基金信息 -->
      <view class="item-info" bindtap="goToFundDetail" data-code="{{item.fundCode}}">
        <view class="item-header">
          <text class="item-name">{{item.fundName}}</text>
          <text class="item-type" wx:if="{{item.ftype}}">{{item.ftype}}</text>
        </view>
        <view class="item-meta">
          <text class="item-code">{{item.fundCode}}</text>
        </view>
      </view>

      <!-- 涨跌幅 -->
      <view class="item-change {{item.changeClass}}" bindtap="goToFundDetail" data-code="{{item.fundCode}}">
        <text class="change-value">{{item.changeText}}</text>
        <text class="nav-value" wx:if="{{item.perNav}}">净值: {{item.perNav}}</text>
      </view>

      <!-- 添加按钮 -->
      <view class="item-action">
        <view
          class="btn-add"
          catchtap="addToWatchlist"
          data-code="{{item.fundCode}}"
          data-name="{{item.fundName}}"
        >+</view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && rankingList.length > 0}}">
    <text>没有更多了</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && rankingList.length === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无排行榜数据</text>
    <text class="empty-hint">请稍后再试或联系管理员同步数据</text>
  </view>
</view>
