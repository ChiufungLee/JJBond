/* pages/ranking/ranking.wxss */
.ranking-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 类型切换 */
.type-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.type-tabs-left {
  display: flex;
  flex: 1;
}

.type-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background-color: #722ed1;
  color: #ffffff;
  font-weight: 500;
}

/* 排序按钮 */
.sort-btn {
  padding: 12rpx 16rpx;
  margin-left: 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.sort-icons {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.sort-icon {
  font-size: 20rpx;
  color: #ccc;
  line-height: 1;
}

.sort-icon.sort-asc {
  margin-bottom: 2rpx;
}

.sort-icon.active {
  color: #722ed1;
  font-weight: bold;
}

/* 更新时间 */
.update-time {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 排行榜列表 */
.ranking-list {
  padding: 24rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 排名 */
.item-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-rank.top {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #ffffff;
  border-radius: 8rpx;
  font-weight: 600;
}

/* 基金信息 */
.item-info {
  flex: 1;
  overflow: hidden;
  margin-right: 16rpx;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.item-type {
  font-size: 20rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-code {
  font-size: 24rpx;
  color: #999;
}

.item-company {
  font-size: 22rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}

/* 涨跌幅 */
.item-change {
  text-align: right;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.change-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.nav-value {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 添加按钮 */
.item-action {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.btn-add {
  font-size: 40rpx;
  color: #722ed1;
  padding: 0 16rpx;
}

/* 涨跌颜色 */
.up {
  color: #ff4d4f;
}

.down {
  color: #52c41a;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #bbb;
}
