<!--pages/mine/mine.wxml-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <!-- 未登录状态 -->
    <block wx:if="{{!loggedIn}}">
      <view class="user-header">
        <view class="avatar">
          <view class="avatar-shield">
            <text class="avatar-yen">¥</text>
          </view>
        </view>
        <view class="user-info">
          <view class="username-row" bindtap="goToLogin">
            <text class="username">未登录</text>
            <text class="login-hint">点击登录 ›</text>
          </view>
          <text class="user-days">登录后查看个人数据</text>
        </view>
      </view>
    </block>

    <!-- 已登录状态 -->
    <block wx:else>
      <view class="user-header">
        <view class="avatar">
          <view class="avatar-shield">
            <text class="avatar-yen">¥</text>
          </view>
        </view>
        <view class="user-info">
          <view class="username-row" bindtap="goToEditProfile">
            <text class="username">{{userInfo.nickname || userInfo.username || '用户'}}</text>
            <image class="edit-icon" src="/icons/edit.svg" mode="aspectFit"></image>
          </view>
          <text class="user-days">已陪伴你 {{daysTogether}} 天</text>
        </view>
      </view>

      <loading wx:if="{{statsLoading}}" text="加载统计中..."></loading>

      <empty
        wx:elif="{{statsError}}"
        icon="⚠️"
        text="{{statsErrorMessage || '加载统计失败，请稍后重试'}}"
        showButton="{{true}}"
        buttonText="重新获取统计"
        bind:buttonTap="loadStats"
      ></empty>

      <!-- 统计数据 -->
      <view class="stats-row" wx:elif="{{stats}}">
        <view class="stat-item">
          <text class="stat-value">{{stats.fundCount}}</text>
          <text class="stat-label">持有基金</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{stats.totalCost}}</text>
          <text class="stat-label">总成本</text>
        </view>
        <view class="stat-item">
          <text class="stat-value {{stats.totalRevenueIsUp ? 'up' : 'down'}}">{{stats.totalRevenue}}</text>
          <text class="stat-label">累计收益</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title">功能</view>
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="title">
        <!-- 普通菜单项 -->
        <view
          wx:if="{{!item.openType}}"
          class="menu-item"
          bindtap="goToMenu"
          data-path="{{item.path}}"
        >
          <view class="menu-left">
            <image class="menu-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            <text class="menu-title">{{item.title}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>

        <!-- 特殊菜单项（使用微信官方功能） -->
        <button
          wx:else
          class="menu-item menu-btn"
          open-type="{{item.openType}}"
        >
          <view class="menu-left">
            <image class="menu-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            <text class="menu-title">{{item.title}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </button>
      </block>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="menu-section" wx:if="{{loggedIn}}">
    <view class="menu-list">
      <view class="menu-item logout-item" bindtap="handleLogout">
        <view class="menu-left">
          <text class="menu-title logout-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version">
    <text>基基棒 v1.0.0</text>
  </view>
</view>
