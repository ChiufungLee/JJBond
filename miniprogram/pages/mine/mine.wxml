<!--pages/mine/mine.wxml-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <!-- 未登录状态 -->
    <block wx:if="{{!loggedIn}}">
      <view class="user-header">
        <view class="avatar-wrapper">
          <image class="avatar" src="/icons/dog.svg" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <view class="username-row" bindtap="goToLogin">
            <text class="username">未登录</text>
            <text class="login-hint">点击登录 ›</text>
          </view>
          <text class="user-days">登录后查看个人数据</text>
        </view>
      </view>
    </block>

    <!-- 已登录状态 -->
    <block wx:else>
      <view class="user-header">
        <!-- 头像：静态展示，暂不开放修改 -->
        <view class="avatar-wrapper">
          <image
            class="avatar"
            src="/icons/dog.svg"
            mode="aspectFill"
          ></image>
        </view>
        <view class="user-info">
          <view class="username-row" bindtap="startEditNickname">
            <input
              wx:if="{{editingNickname}}"
              class="nickname-input"
              value="{{nickname}}"
              focus="{{editingNickname}}"
              placeholder="请输入昵称"
              bindblur="onNicknameBlur"
              bindinput="onNicknameInput"
              bindconfirm="onNicknameBlur"
            />
            <block wx:else>
              <text class="username">{{userInfo.nickname || userInfo.username || '用户'}}</text>
              <image class="edit-icon" src="/icons/edit.svg" mode="aspectFit"></image>
            </block>
          </view>
          <text class="user-days">已陪伴你 {{daysTogether}} 天</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-list">
      <block wx:for="{{menuList}}" wx:key="title">
        <view
          class="menu-item"
          bindtap="goToMenu"
          data-path="{{item.path}}"
          data-noauth="{{item.noAuth}}"
        >
          <view class="menu-left">
            <image class="menu-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            <text class="menu-title">{{item.title}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 更多 -->
  <view class="menu-section">
    <view class="menu-list">
      <block wx:for="{{moreList}}" wx:key="title">
        <!-- 普通菜单项 -->
        <view
          wx:if="{{!item.openType}}"
          class="menu-item"
          bindtap="goToMenu"
          data-path="{{item.path}}"
          data-noauth="{{item.noAuth}}"
        >
          <view class="menu-left">
            <image class="menu-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            <text class="menu-title">{{item.title}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>

        <!-- 联系客服（微信官方功能） -->
        <button
          wx:else
          class="menu-item menu-btn"
          open-type="{{item.openType}}"
        >
          <view class="menu-left">
            <image class="menu-icon" src="/icons/{{item.icon}}.svg" mode="aspectFit"></image>
            <text class="menu-title">{{item.title}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </button>
      </block>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version">
    <text>基基棒 v2.3.6</text>
  </view>
</view>
