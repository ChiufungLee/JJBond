/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  padding: 60rpx 60rpx;
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
}

.register-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.register-form {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 28rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 96rpx;
}

.input-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.input-wrapper .input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
  padding: 0;
  height: 96rpx;
}

.btn-register {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-register::after {
  border: none;
}

.btn-register[disabled] {
  opacity: 0.7;
}

.login-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #666666;
}

.link {
  color: #722ed1;
  margin-left: 8rpx;
}
