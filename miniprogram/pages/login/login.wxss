/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #722ed1 0%, #b37feb 100%);
  display: flex;
  flex-direction: column;
  padding: 0 60rpx;
}

.login-header {
  text-align: center;
  padding-top: 200rpx;
  margin-bottom: 100rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-text {
  text-align: center;
  margin-bottom: 80rpx;
}

.welcome-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.welcome-desc {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

/* 微信登录按钮 */
.btn-wechat-login {
  width: 100%;
  max-width: 600rpx;
  height: 100rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
}

.btn-wechat-login::after {
  border: none;
}

.btn-wechat-login[disabled] {
  opacity: 0.8;
  box-shadow: none;
}

.wechat-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  color: #ffffff;
}

.login-tips {
  margin-top: 40rpx;
  text-align: center;
}

.login-tips text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}
