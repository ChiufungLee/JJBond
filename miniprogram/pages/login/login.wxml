<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="login-header">
    <image class="logo" src="/icons/logo.png" mode="aspectFit"></image>
  </view>

  <view class="login-content">
    <view class="welcome-text">
      <text class="welcome-title">欢迎使用基基棒</text>
      <text class="welcome-desc">使用微信快捷登录，即可开始管理您的基金</text>
    </view>

    <button
      class="btn-wechat-login"
      bindtap="handleWechatLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      <image class="wechat-icon" src="/icons/login.svg" mode="aspectFit" wx:if="{{!loading}}"></image>
      <text>{{loading ? '登录中...' : '微信登录'}}</text>
    </button>

    <view class="login-tips">
      <text>首次登录将自动注册账号</text>
    </view>
  </view>
</view>
