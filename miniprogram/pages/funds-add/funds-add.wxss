/* pages/funds-add/funds-add.wxss */
.add-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* 搜索区域 */
.search-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 已选中基金 */
.selected-fund {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f9f0ff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #722ed1;
}

.selected-info {
  flex: 1;
}

.selected-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.selected-code {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.clear-btn {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 搜索结果 */
.search-results {
  margin-top: 20rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-info {
  flex: 1;
}

.result-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.result-code {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.result-type {
  font-size: 24rpx;
  color: #722ed1;
  background-color: #f9f0ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 搜索中 */
.searching {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 表单区域 */
.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background-color: #722ed1;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 48rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.7;
}
