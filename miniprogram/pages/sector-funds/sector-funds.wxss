.sector-funds-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 板块涨跌详情 */
.sector-detail {
  margin: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.sector-detail-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
  text-align: center;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #722ed1;
  margin: 0 auto 24rpx;
  width: fit-content;
}

.sector-detail-changes {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
}

.change-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.change-label {
  font-size: 24rpx;
  color: #999;
}

.change-item .change-value {
  font-size: 32rpx;
  font-weight: 600;
}

/* 列表表头 */
.list-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin: 0 24rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx 8rpx 0 0;
  font-size: 24rpx;
  color: #999;
}

.header-info {
  flex: 1;
  padding-left: 68rpx;
}

.header-month {
  width: 140rpx;
  text-align: center;
  flex-shrink: 0;
}

.col-sortable {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.sort-icons {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.sort-icon {
  font-size: 16rpx;
  color: #ccc;
  line-height: 16rpx;
}

.sort-icon.active {
  color: #722ed1;
}

/* 基金列表 */
.fund-list {
  padding: 0 24rpx 24rpx;
}

.fund-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 24rpx;
  margin-bottom: 2rpx;
}

.fund-item:last-child {
  border-radius: 0 0 8rpx 8rpx;
  margin-bottom: 16rpx;
}

.fund-item:first-of-type {
  border-radius: 0;
}

.fund-item.highlight {
  background-color: #efdbff;
  border-left: 6rpx solid #722ed1;
}

.item-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-rank.top {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #ffffff;
  border-radius: 8rpx;
  font-weight: 600;
}

.item-info {
  flex: 1;
  overflow: hidden;
  margin-right: 16rpx;
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-code {
  font-size: 24rpx;
  color: #999;
}

.item-month {
  width: 140rpx;
  text-align: center;
  flex-shrink: 0;
}

.month-value {
  font-size: 28rpx;
  font-weight: 500;
}

.up { color: #ff4d4f; }
.down { color: #52c41a; }

.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #bbb;
  font-size: 24rpx;
}
